# Optional. Without it, the contact form uses FormSubmit (no key; one-time activation email).
# With a free key from https://web3forms.com, messages are delivered via Web3Forms instead.
VITE_WEB3FORMS_KEY=

# Optional. A free GIPHY key (https://developers.giphy.com) enables GIF + sticker search in the blog studio.
VITE_GIPHY_KEY=
